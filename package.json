{
  "name": "navrya",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/write-version.mjs && vite",
    "dev:api": "node --env-file-if-exists=.env server/pattern-ai-server.mjs",
    "dev:community-api": "NO_PROXY=\"${NO_PROXY:+$NO_PROXY,}www.googleapis.com,oauth2.googleapis.com,accounts.google.com\" no_proxy=\"${no_proxy:+$no_proxy,}www.googleapis.com,oauth2.googleapis.com,accounts.google.com\" node --env-file-if-exists=.env server/community-api-server.mjs",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/write-version.mjs && node navrya-src/build.mjs && vite build",
    "build:navrya": "node navrya-src/build.mjs",
    "ai:knowledge:build": "node scripts/ai-knowledge-build.mjs build",
    "ai:knowledge:check": "node scripts/ai-knowledge-build.mjs check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@openai/agents-realtime": "^0.16.1",
    "argon2": "^0.45.1",
    "cookie": "^2.0.1",
    "express": "^4.22.2",
    "google-auth-library": "^11.0.0",
    "ioredis": "^6.0.0",
    "lucide": "^1.24.0",
    "openid-client": "^6.8.7",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autocannon": "^8.0.0",
    "jose": "^6.2.10",
    "vite": "^5.4.10"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
