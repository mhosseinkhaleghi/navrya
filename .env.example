OPENAI_API_KEY=replace_with_your_server_side_key
OPENAI_MODEL=gpt-5.6
# Optional: overrides the model used to mint Realtime Voice (Journey E) ephemeral client secrets
# (server/pattern-ai-server.mjs mintRealtimeClientSecret()). Leave unset to use the current
# default (gpt-realtime-2.1) - see docs/ai/voice-architecture.md.
OPENAI_REALTIME_MODEL=
PATTERN_AI_PORT=8787

# Optional: additional AI providers for the global assistant dock's multi-provider gateway
# (server/pattern-ai-server.mjs). Each is only used as a server-side default - a user's
# own BYO key from Settings, sent per-request, always overrides it for that call.
ANTHROPIC_API_KEY=replace_with_your_server_side_key
ANTHROPIC_MODEL=claude-sonnet-4-5
KIMI_API_KEY=replace_with_your_server_side_key
KIMI_MODEL=moonshot-v1-8k
DEEPSEEK_API_KEY=replace_with_your_server_side_key
DEEPSEEK_MODEL=deepseek-chat

# ElevenLabs voice-provider integration (docs/ai/elevenlabs-voice-providers.md). The NORMAL path
# is fully admin-managed from the live Admin -> AI -> Voice Providers panel (encrypted at rest in
# Postgres, no redeploy needed to add/rotate a key or change a language's voice/model) - none of
# the vars below are required for that path. They exist ONLY as an emergency/bootstrap fallback
# (tier 2 of the documented runtime precedence, admin config > this > OpenAI voice), and stay
# fully inert unless BOTH ELEVENLABS_EMERGENCY_ENV_FALLBACK=true AND an admin has not already
# configured Persian (an enabled admin config always wins - see resolveElevenLabsForLanguage() in
# server/pattern-ai-server.mjs). ELEVENLABS_API_KEY is a real secret - set it only in the
# production secret manager, never here.
ELEVENLABS_EMERGENCY_ENV_FALLBACK=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_FA=buzGl6hokx2gx74EYLO0
ELEVENLABS_MODEL_ID_FA=eleven_v3
ELEVENLABS_LANGUAGE_CODE_FA=fa

# Community backend (server/community-api-server.mjs) - a separate process/port from the AI
# gateway above. This is the project's first real database - only the Community feature
# (social feed, marketplace, messaging) uses it; every other feature stays local-first.
# Local Postgres: `docker compose up -d`, then `npm.cmd run db:migrate`.
DATABASE_URL=postgres://tradejournal:tradejournal@127.0.0.1:5432/tradejournal
COMMUNITY_API_PORT=8788
UPLOADS_DIR=./uploads

# Admin panel (server/admin/) authorization - fails CLOSED by default (unset or any value other
# than the literal string "false" means enforced: only a real users.role='admin' account can use
# /api/admin/*). Set to the literal string `false` ONLY for local testing convenience (every
# identified user is then treated as admin) - server/admin/auth-admin.mjs refuses to start this
# way under NODE_ENV=production. Provision the first real admin locally with:
# node scripts/admin-grant.mjs --email=you@example.com --confirm=you@example.com
ADMIN_AUTH_ENFORCED=

# Real, cookie-based sessions (server/community/security/session-service.mjs,
# server/community/routes.auth.mjs) - see docs/auth/ADR-0001-authentication-architecture.md.
# Signs sessions/CSRF tokens. If left unset, a random secret is generated in memory at startup
# (logged loudly) - fine for local dev, but every session is invalidated on restart, and
# NODE_ENV=production refuses to start without a real value set. Generate one with:
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
AUTH_TOKEN_SECRET=
# A DIFFERENT random value from AUTH_TOKEN_SECRET above, same generation command - signs the
# CSRF double-submit cookie (server/community/security/csrf.mjs). Same dev-fallback/production-
# required behavior as AUTH_TOKEN_SECRET.
CSRF_SECRET=
# 32 bytes, hex-encoded (64 hex characters) - server/community/security/crypto-util.mjs's real
# AES-256-GCM at-rest encryption. Protects users.totp_secret_enc AND (as of the ElevenLabs
# voice-provider feature) admin_voice_provider_credentials.api_key_encrypted - a second real
# consumer of the same key, not a new secret. If left unset, a random ephemeral key is generated
# in memory at startup for local dev only (logged loudly - old ciphertext becomes undecryptable
# across a restart); NODE_ENV=production refuses to start without a real value. Generate with the
# same command as AUTH_TOKEN_SECRET above.
ENCRYPTION_KEY=
# There is no ADMIN_BOOTSTRAP_EMAIL setting any more - public-registration auto-promotion to
# admin was removed entirely as a real security hole. Provision the first admin locally with:
# node scripts/admin-grant.mjs --email=you@example.com --confirm=you@example.com
# (requires the account to have verified its email first; see that script's own --help output).
# Distributed rate limiting/AI-quota store (server/community/security/rate-limit.mjs). Leave
# unset for local dev - an in-memory store is used automatically and logged once; NODE_ENV=
# production refuses to start without a real REDIS_URL. `docker compose up -d` does not provision
# Redis by default for local dev; add a redis service locally only if you want to exercise the
# real ioredis code path (see docker-compose.production.yml for the production shape).
REDIS_URL=
# Comma-separated browser origins allowed to call this API with credentials
# (server/community/security/origins.mjs). Leave unset for local dev (defaults to the Vite dev
# server origins); NODE_ENV=production refuses to start without this set explicitly.
ALLOWED_ORIGINS=
# Google OAuth Client ID (NOT a client secret - none is needed for the Sign-In-With-Google ID
# token flow this app uses). Get one from console.cloud.google.com -> APIs & Services ->
# Credentials -> Create Credentials -> OAuth client ID -> Web application. The SAME value must
# also be placed in public/pages/select/app.js's GOOGLE_CLIENT_ID constant, since that page
# is plain static JS (not Vite-processed) and can't read this env var at runtime. Leave unset to
# disable the Google sign-in button (POST /api/auth/google then returns a clean 503).
GOOGLE_CLIENT_ID=443787785968-2e2nvrnt4lsq70ob5i2pvj3ujo6uekmf.apps.googleusercontent.com
# Optional: protects the server-to-server /internal/admin-ai-keys route (called by
# pattern-ai-server.mjs to resolve admin-configured AI keys - see COMMUNITY_API_URL below).
# Left unset in local/zero-setup dev, where that route is reachable without a secret.
INTERNAL_API_SECRET=

# Read by server/pattern-ai-server.mjs so it can poll the Community API's
# /internal/admin-ai-keys route (cached ~60s) instead of talking to Postgres directly.
COMMUNITY_API_URL=http://127.0.0.1:8788
# Opt-in commercial AI wallet gate. Leave false for local development and until production
# provider pricing plus user balances have been configured.
AI_WALLET_ENFORCED=false
# Read by server/admin/routes.mjs (community-api-server.mjs) for the admin Technical tab's AI
# gateway health check - the reverse direction of COMMUNITY_API_URL above.
PATTERN_AI_URL=http://127.0.0.1:8787

# Bind address for both servers. Leave unset for local dev (defaults to 127.0.0.1, loopback
# only). A hosting platform that routes external traffic to a container's public interface
# (Render, Railway, Fly, Docker) needs this set to 0.0.0.0 so the process actually accepts
# outside connections - see server/pattern-ai-server.mjs and server/community-api-server.mjs.
HOST=127.0.0.1
# Most hosting platforms inject PORT and expect the app to bind to it; when set, PORT takes
# priority over PATTERN_AI_PORT / COMMUNITY_API_PORT above (both servers check PORT first).
PORT=

# Extra shared-secret gate for a public preview deploy, on top of real per-user authentication
# above - a cheap way to keep the whole preview away from bots/crawlers/randos before you're
# ready for fully open signup. Set both once a public link is being handed to testers/investors.
# The browser's native Basic Auth prompt asks for them once and caches for the session. Leave
# both unset for local dev (this extra gate is then skipped entirely).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Generic OIDC (docs/auth/ADR-0001, section 1) - leave every value below unset to run password +
# Google sign-in only, exactly as before this pass. OIDC_ISSUER_URL is the provider's base issuer
# URL (its /.well-known/openid-configuration is fetched automatically); OIDC_REDIRECT_URI must
# exactly match what is registered with the provider.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8788/api/auth/oidc/callback
# Test/local-only: allows the OIDC adapter to talk to a plain-HTTP issuer (e.g. a local mock
# issuer in tests). NEVER set this in production - discovery() otherwise refuses non-HTTPS
# issuers by design, which is real protection against a misconfigured production issuer URL.
OIDC_ALLOW_INSECURE_ISSUER=

# Time-boxed legacy bearer-token exchange sunset (docs/auth/ADR-0001, section 2/4). Leave unset
# to keep POST /api/auth/legacy-exchange permanently disabled - the correct default for a fresh
# install with no pre-existing tokens in the wild.
LEGACY_AUTH_SUNSET_AT=

# Outbound email for password-reset/verification links (server/community/security/mailer.mjs).
# Left unset in local dev: the reset/verify link is logged to the console instead of sent.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=

# AI usage ceilings (server/pattern-ai-server.mjs) - defaults shown are also the built-in
# fallback if left unset.
AI_QUOTA_PER_USER_PER_HOUR=200
AI_QUOTA_GLOBAL_PER_HOUR=20000

# Reverse-proxy hop count for req.ip resolution (server/community/app.mjs). Leave unset/0 for
# local dev (no reverse proxy in front of this process).
TRUST_PROXY_HOPS=0

# Content-Security-Policy: report-only by default (see server/community/security/headers.mjs) so
# violations can be reviewed before enforcing. Set to 'true' once the real static build has been
# checked against the policy.
CSP_ENFORCE=false

# Real BSC (BNB Smart Chain) crypto payment provider (server/commercial/bsc-crypto-billing-provider.mjs).
#
# PRODUCTION CONFIGURATION NO LONGER LIVES HERE. An admin configures and activates BSC crypto
# payments from Admin > Commercial > Crypto payments - public settings (chain id, deposit address,
# token, decimals, exchange rate, confirmations, invoice expiry) are stored in the database
# (commercial_config_overrides, versioned like every other commercial setting), and the two real
# secrets (RPC URL, optional webhook HMAC secret) are stored encrypted-at-rest
# (bsc_payment_secrets - see 039_bsc_payment_secrets.sql). "Enabled" is a DB-only flag - it is
# NEVER read from this file, so setting BSC_* here can never silently turn real payments on.
#
# Every variable below is read ONLY as a local-development/bootstrap fallback - only when the
# admin-managed value for that field is unset - never as the production source of truth. Leave
# them all unset in production and configure everything through the Admin UI instead.
BSC_RPC_URL=
# 56 = BSC mainnet (production must be this). 97 = BSC testnet, for end-to-end testing before
# going live - this repo's own chain-id cross-check refuses to create or confirm an invoice if
# the configured RPC endpoint reports a different chain than this.
BSC_CHAIN_ID=56
# The wallet address that receives every crypto payment. Custody of the matching private key is
# entirely an operator/treasury concern outside this application - it is never stored or handled
# here.
BSC_DEPOSIT_ADDRESS=
# The BEP-20 token accepted for payment (default assumption: a USD-pegged stablecoin like USDT).
BSC_TOKEN_SYMBOL=USDT
BSC_TOKEN_CONTRACT=
# BSC's USDT uses 18 decimals (unlike Ethereum mainnet USDT's 6) - verify the real decimals of
# whichever token contract you configure; this value is not guessed.
BSC_TOKEN_DECIMALS=18
# USD value of one whole token unit, snapshotted onto every invoice created while this is in
# effect. Leave at 1 for a USD-pegged stablecoin (the only rate this system can state honestly
# without integrating a live price feed) - a non-stablecoin asset needs a real price source wired
# in before this is meaningfully more than 1.
BSC_EXCHANGE_RATE_USD_PER_TOKEN=1
# How many block confirmations a transfer needs before a payment counts as verified.
BSC_CONFIRMATIONS_REQUIRED=15
# How long a generated invoice stays payable before it expires unconfirmed.
BSC_INVOICE_EXPIRY_MINUTES=30
# Real secret - HMAC-SHA256 key for the optional inbound webhook (POST /api/webhooks/bsc), for a
# future real indexer/gateway push source. Leave unset to keep that route refusing every request
# (WEBHOOK_NOT_SUPPORTED) - the client's own "Check Now"/auto-poll flow works fully without it.
# Set only in the production secret manager, never here, exactly like ELEVENLABS_API_KEY above.
BSC_WEBHOOK_SECRET=
