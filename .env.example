OPENAI_API_KEY=replace_with_your_server_side_key
OPENAI_MODEL=gpt-5.6
PATTERN_AI_PORT=8787

# Optional: additional AI providers for the global assistant dock's multi-provider gateway
# (server/pattern-ai-server.mjs). Each is only used as a server-side default - a user's
# own BYO key from Settings, sent per-request, always overrides it for that call.
ANTHROPIC_API_KEY=replace_with_your_server_side_key
ANTHROPIC_MODEL=claude-sonnet-4-5
KIMI_API_KEY=replace_with_your_server_side_key
KIMI_MODEL=moonshot-v1-8k
DEEPSEEK_API_KEY=replace_with_your_server_side_key
DEEPSEEK_MODEL=deepseek-chat

# Community backend (server/community-api-server.mjs) - a separate process/port from the AI
# gateway above. This is the project's first real database - only the Community feature
# (social feed, marketplace, messaging) uses it; every other feature stays local-first.
# Local Postgres: `docker compose up -d`, then `npm.cmd run db:migrate`.
DATABASE_URL=postgres://tradejournal:tradejournal@127.0.0.1:5432/tradejournal
COMMUNITY_API_PORT=8788
UPLOADS_DIR=./uploads

# Admin panel (server/admin/) - built but inactive by default. Leave unset/false for quick local
# testing (every logged-in user is then treated as admin). Set to `true` once you're ready to
# enforce real admin accounts (users.role = 'admin', see ADMIN_BOOTSTRAP_EMAIL below).
ADMIN_AUTH_ENFORCED=false

# Real authentication (server/community/routes.auth.mjs, auth-real.mjs, auth-tokens.mjs) -
# replaces the old dev-mode x-dev-user-id trust model with email/password + Google sign-in.
# Signs/verifies session tokens. If left unset, a random secret is generated in memory at
# startup (logged loudly) - fine for local dev, but every session is invalidated on restart.
# Set a real value (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# once a public host is in the picture.
AUTH_TOKEN_SECRET=
# The email that gets auto-promoted to role=admin the moment it registers or first signs in
# with Google (only checked at account-creation time, never on ordinary login - see
# routes.auth.mjs's bootstrapAdminIfMatch). Leave unset to skip auto-promotion entirely.
ADMIN_BOOTSTRAP_EMAIL=
# Google OAuth Client ID (NOT a client secret - none is needed for the Sign-In-With-Google ID
# token flow this app uses). Get one from console.cloud.google.com -> APIs & Services ->
# Credentials -> Create Credentials -> OAuth client ID -> Web application. The SAME value must
# also be placed in public/pages/select/index.html's GOOGLE_CLIENT_ID constant, since that page
# is plain static JS (not Vite-processed) and can't read this env var at runtime. Leave unset to
# disable the Google sign-in button (POST /api/auth/google then returns a clean 503).
GOOGLE_CLIENT_ID=
# Optional: protects the server-to-server /internal/admin-ai-keys route (called by
# pattern-ai-server.mjs to resolve admin-configured AI keys - see COMMUNITY_API_URL below).
# Left unset in local/zero-setup dev, where that route is reachable without a secret.
INTERNAL_API_SECRET=

# Read by server/pattern-ai-server.mjs so it can poll the Community API's
# /internal/admin-ai-keys route (cached ~60s) instead of talking to Postgres directly.
COMMUNITY_API_URL=http://127.0.0.1:8788
# Read by server/admin/routes.mjs (community-api-server.mjs) for the admin Technical tab's AI
# gateway health check - the reverse direction of COMMUNITY_API_URL above.
PATTERN_AI_URL=http://127.0.0.1:8787

# Bind address for both servers. Leave unset for local dev (defaults to 127.0.0.1, loopback
# only). A hosting platform that routes external traffic to a container's public interface
# (Render, Railway, Fly, Docker) needs this set to 0.0.0.0 so the process actually accepts
# outside connections - see server/pattern-ai-server.mjs and server/community-api-server.mjs.
HOST=127.0.0.1
# Most hosting platforms inject PORT and expect the app to bind to it; when set, PORT takes
# priority over PATTERN_AI_PORT / COMMUNITY_API_PORT above (both servers check PORT first).
PORT=

# Extra shared-secret gate for a public preview deploy, on top of real per-user authentication
# above - a cheap way to keep the whole preview away from bots/crawlers/randos before you're
# ready for fully open signup. Set both once a public link is being handed to testers/investors.
# The browser's native Basic Auth prompt asks for them once and caches for the session. Leave
# both unset for local dev (this extra gate is then skipped entirely).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
