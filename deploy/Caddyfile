{
	admin off
}

(navrya_api) {
	@ai path /api/patterns/* /api/strategy-education/* /api/trades/* /api/mental-health/* /api/ai/* /api/sessions/*
	handle @ai {
		reverse_proxy pattern-ai:8787
	}

	handle /api/* {
		reverse_proxy community-api:8788
	}

	handle /uploads/* {
		reverse_proxy community-api:8788
	}
}

(navrya_static) {
	handle {
		encode zstd gzip
		root * /srv
		# PRODUCTION INCIDENT FIX (2026-08-31): `try_files {path} /index.html` alone only ever
		# resolves an EXACT file match (e.g. /pages/hunter/index.html) - it never tried
		# `{path}/index.html`, so a directory-style request (/pages/hunter/, the normal way a
		# browser navigates there) fell straight through to the SPA-fallback root /index.html
		# (a different, minimal shell page) instead of that directory's own real index.html.
		# Confirmed live: the exact file path served the correct 17KB character app, the
		# trailing-slash directory path served the wrong 632-byte shell - this is what broke the
		# whole app on any fresh navigation/reload. Adding the directory-index candidate fixes it.
		try_files {path} {path}/index.html /index.html
		# PRODUCTION INCIDENT FIX (2026-09-04): the character app bundles
		# (navrya-{hunter,commander,engineer,sage}-sessions-app.js) and admin/index.html's own
		# app.js are served under a fixed, never-versioned filename with no query-string/content
		# hash - Vite's default `public/` passthrough copies them into dist/ verbatim, byte-
		# identical path every deploy. With no Cache-Control header at all (the previous state),
		# browsers fall back to their own heuristic caching, which can and did serve an old,
		# already-fixed-server-side bug straight out of a returning user's disk cache for an
		# indeterminate time after a real deploy - confirmed twice live (an admin seeing a stale
		# Conversation Studio panel, then a user seeing a Voice Mode regression that had already
		# been fixed and redeployed). `no-cache` (NOT `no-store`) keeps every real caching/
		# conditional-GET benefit (a Caddy `file_server` already sets ETag/Last-Modified, so an
		# unchanged file still round-trips as a cheap 304, not a full re-download) while forcing a
		# real revalidation with this server on every load - the one guarantee that matters here:
		# a fresh deploy is visible on the very next page load, not "eventually, once each
		# individual browser's own cache heuristic happens to expire."
		header Cache-Control "no-cache"
		file_server
	}
}

{$APP_HOST:app.navrya.com} {
	import navrya_api
	import navrya_static
}

{$ADMIN_HOST:admin.navrya.com} {
	import navrya_api
	import navrya_static
}

navrya.com, www.navrya.com {
	encode zstd gzip
	reverse_proxy navrya-marketing:3000
}
