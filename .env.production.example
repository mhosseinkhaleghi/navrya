# Production environment template (server/community-api-server.mjs and
# server/pattern-ai-server.mjs both refuse to start under NODE_ENV=production if a required
# value below is missing - see docs/auth/ADR-0001-authentication-architecture.md and
# docs/auth/IMPLEMENTATION_STATUS.md for the full reasoning behind each one).
NODE_ENV=production

# Database (use long, random values in the real server-side .env)
POSTGRES_USER=navrya
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=navrya
DATABASE_URL=postgres://navrya:replace-with-a-long-random-password@postgres:5432/navrya

# Public hostnames. Use staging.navrya.com and admin.staging.navrya.com on staging.
APP_HOST=app.navrya.com
ADMIN_HOST=admin.navrya.com

# REQUIRED in production: distributed rate limiting (server/community/security/rate-limit.mjs)
# and AI-quota counters both need a real, shared Redis instance so every horizontally-scaled API
# replica enforces the same limits - an in-memory store is dev/test-only and the server refuses
# to start without this set. docker-compose.production.yml provisions a `redis` service.
REDIS_URL=redis://redis:6379

# Session/CSRF signing and at-rest encryption - each MUST be an independent, long random value.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
CSRF_SECRET=replace-with-a-DIFFERENT-32-plus-random-bytes-value
# 32 bytes, hex-encoded (64 hex characters) - protects users.totp_secret_enc AND (as of the
# ElevenLabs voice-provider feature) admin_voice_provider_credentials.api_key_encrypted. Preflighted
# explicitly by .github/workflows/deploy.yml before this ever touches a running container. Generate
# with the same command as above.
ENCRYPTION_KEY=replace-with-64-hex-characters-32-bytes

# Server-to-server shared secret protecting /internal/* routes - required in production for both
# the admin-key bridge and the AI gateway's session-introspection call (ADR-0001 section 6).
INTERNAL_API_SECRET=replace-with-an-independent-random-secret

# Exact, explicit list of browser origins allowed to call this API with credentials (comma-
# separated, no wildcards - server/community/security/origins.mjs). Required in production.
ALLOWED_ORIGINS=https://app.navrya.com,https://admin.navrya.com

# Reverse-proxy hop count for req.ip resolution (Caddy sits directly in front - one hop). Getting
# this wrong either trusts a forgeable X-Forwarded-For (too high) or mis-attributes every
# request's IP for rate-limiting/audit purposes (too low/unset).
TRUST_PROXY_HOPS=1

# Generic OIDC (ADR-0001 section 1) - leave unset to run password + Google sign-in only.
# OIDC_ISSUER_URL is the provider's base issuer URL (discovery is fetched from
# <OIDC_ISSUER_URL>/.well-known/openid-configuration); OIDC_REDIRECT_URI must exactly match what
# is registered with the provider.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://app.navrya.com/api/auth/oidc/callback

# Time-boxed legacy bearer-token exchange sunset (ADR-0001 section 2/4) - an ISO date in the
# future enables the one-time POST /api/auth/legacy-exchange for browsers holding a pre-existing
# token from before this change shipped; leave unset (or in the past) to keep it permanently
# disabled, which is the correct default for a fresh deployment with no legacy tokens in the wild.
LEGACY_AUTH_SUNSET_AT=

# Outbound email for password-reset/verification links (server/community/security/mailer.mjs).
# Point this at any transactional-email provider or internal relay with an inbound webhook -
# without it, production logs a loud warning and does NOT send the email (never silently exposes
# the raw link in an API response outside local development).
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=

# Content-Security-Policy: report-only until real violations have been reviewed against the
# actual deployed static build, then flip to enforced (server/community/security/headers.mjs).
CSP_ENFORCE=false

# AI usage ceilings (server/pattern-ai-server.mjs) - server-authoritative, Redis-backed, never
# trusts a client-supplied usage total.
AI_QUOTA_PER_USER_PER_HOUR=200
AI_QUOTA_GLOBAL_PER_HOUR=20000
# Commercial AI wallet rollout guard. Enable only after provider pricing and existing-user
# balances are configured; otherwise every platform-funded AI call correctly fails closed.
AI_WALLET_ENFORCED=false

# Admin authorization must never be disabled in production - server/admin/auth-admin.mjs throws
# at startup if this is explicitly set to "false" under NODE_ENV=production. Leave it unset/true.
ADMIN_AUTH_ENFORCED=true
# There is no ADMIN_BOOTSTRAP_EMAIL any more - that auto-promotion path was removed entirely
# (a real security hole: a public registration matching a committed email became admin before
# proving ownership of it). Provision the first admin out of band once the account has verified
# its email: node scripts/admin-grant.mjs --email=you@example.com --confirm=you@example.com

# Optional sign-in and AI providers. Leave blank to disable those integrations initially.
GOOGLE_CLIENT_ID=443787785968-2e2nvrnt4lsq70ob5i2pvj3ujo6uekmf.apps.googleusercontent.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Realtime Voice (server/pattern-ai-server.mjs's mintRealtimeClientSecret()) uses OPENAI_API_KEY
# above - no separate key. This overrides only the model used to mint Realtime client secrets;
# leave blank to use the built-in default (gpt-realtime-2.1). Passed through in
# docker-compose.production.yml.
OPENAI_REALTIME_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ElevenLabs voice-provider integration (docs/ai/elevenlabs-voice-providers.md). The real,
# supported path is fully admin-managed from the live Admin -> AI -> Voice Providers panel
# (encrypted at rest, no redeploy to add/rotate a key or change a language's voice/model) - none
# of the vars below are needed for that. They exist only as an explicit, opt-in emergency/
# bootstrap fallback (runtime precedence tier 2: admin config > this > OpenAI voice) - leave
# ELEVENLABS_EMERGENCY_ENV_FALLBACK unset/false (the default) to keep this tier fully inert, even
# if the other values below happen to be set. Passed through in docker-compose.production.yml.
ELEVENLABS_EMERGENCY_ENV_FALLBACK=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_FA=
ELEVENLABS_MODEL_ID_FA=eleven_v3
ELEVENLABS_LANGUAGE_CODE_FA=fa
