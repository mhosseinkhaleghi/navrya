# Database (use long, random values in the real server-side .env)
POSTGRES_USER=navrya
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=navrya

# Authentication and private service-to-service calls
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
INTERNAL_API_SECRET=replace-with-an-independent-random-secret
ADMIN_BOOTSTRAP_EMAIL=you@example.com

# Optional sign-in and AI providers. Leave blank to disable those integrations initially.
GOOGLE_CLIENT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
